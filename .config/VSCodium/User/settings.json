{
  // ── Lily × VSCodium ────────────────────────────────────────────────
  // Palette comes from the generated "Lily" theme extension; matugen
  // rewrites it from the wallpaper. This file only owns layout and taste.
  "workbench.colorTheme": "Lily",
  "workbench.preferredDarkColorTheme": "Lily",
  "workbench.iconTheme": "lily-material-icons",

  "window.titleBarStyle": "native",
  "window.customTitleBarVisibility": "never",
  "window.title": "${activeEditorShort}${separator}${rootName}",
  "window.commandCenter": false,
  "window.menuBarVisibility": "toggle",
  "window.autoDetectColorScheme": false,
  "window.zoomLevel": 0,
  "window.closeWhenEmpty": false,
  "window.newWindowDimensions": "inherit",
  "window.restoreWindows": "all",
  "workbench.layoutControl.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.labelFormat": "short",
  "workbench.editor.enablePreview": false,
  "workbench.editor.tabActionLocation": "right",
  "workbench.editor.tabCloseButton": "right",
  "workbench.editor.showIcons": true,
  "workbench.editor.scrollToSwitchTabs": true,
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.list.smoothScrolling": true,
  "workbench.statusBar.visible": true,
  "workbench.panel.defaultLocation": "bottom",
  "workbench.panel.opensMaximized": "never",
  "workbench.sideBar.location": "left",
  "workbench.tips.enabled": false,
  "workbench.enableExperiments": false,

  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'SpaceMono Nerd Font', monospace",
  "editor.fontLigatures": "'calt', 'liga', 'zero', 'ss02'",
  "editor.fontSize": 13.5,
  "editor.lineHeight": 1.6,
  "editor.fontWeight": "400",
  "editor.letterSpacing": 0.2,
  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.padding.top": 10,
  "editor.padding.bottom": 14,
  "editor.guides.indentation": false,
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": "active",
  "editor.guides.highlightActiveIndentation": true,
  "editor.renderWhitespace": "selection",
  "editor.renderLineHighlight": "all",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.scrollbar.vertical": "auto",
  "editor.scrollbar.horizontal": "auto",
  "editor.scrollbar.verticalScrollbarSize": 8,
  "editor.scrollbar.horizontalScrollbarSize": 8,
  "editor.scrollbar.useShadows": false,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "smooth",
  "editor.cursorWidth": 2,
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.linkedEditing": true,
  "editor.lightbulb.enabled": "on",
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": true,
  "editor.suggest.preview": true,
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.tabCompletion": "on",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },
  "editor.wordWrap": "off",
  "editor.inlayHints.enabled": "onUnlessPressed",
  "editor.inlayHints.padding": true,

  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "terminal.integrated.fontSize": 12.5,
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.enableVisualBell": false,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.location": "left",

  "explorer.compactFolders": false,
  "explorer.openEditors.visible": 0,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,

  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",

  // VSCodeVim — modal editing that matches nvim.
  "vim.leader": " ",
  "vim.useSystemClipboard": true,
  "vim.relativeLineNumbers": true,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 250,
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.ignorecase": true,
  "vim.smartcase": true,
  "vim.wrapscan": true,
  "vim.statusBarColorControl": false,
  "vim.smoothScrolling": true,
  "vim.cursorSurroundingLines": 8,
  "vim.startInInsertMode": false,
  "vim.useCtrlKeys": true,
  "vim.easymotion": false,
  "vim.sneak": false,

  "security.workspace.trust.enabled": false,
  "telemetry.telemetryLevel": "off",
  "update.mode": "none",
  "extensions.autoUpdate": "on",

  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true
}
