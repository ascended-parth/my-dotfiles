  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#707070",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, control flow, storage",
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#b9c4d4"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.definition.operator"],
      "settings": {
        "foreground": "#9aa3ae"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string", "constant.other.symbol"],
      "settings": {
        "foreground": "#a8bda8"
      }
    },
    {
      "name": "Regexp and escapes",
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": {
        "foreground": "#c2b09a"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"],
      "settings": {
        "foreground": "#d0b98f"
      }
    },
    {
      "name": "Functions and methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": {
        "foreground": "#c9b6cf"
      }
    },
    {
      "name": "Types, classes, namespaces",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class"],
      "settings": {
        "foreground": "#a9c3c9"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.language"],
      "settings": {
        "foreground": "#d6d6d6"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": {
        "foreground": "#c3bcb0"
      }
    },
    {
      "name": "Properties and fields",
      "scope": ["variable.object.property", "variable.other.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": {
        "foreground": "#c9c9c9"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#c6a8a5"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#c2b09a"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": {
        "foreground": "#8d8d8d"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#d98a8a",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#e2e2e2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#a8bda8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#d0b98f"
      }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#b9c4d4",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#9fc6a3"
      }
    },
    {
      "name": "Markup deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#d98a8a"
      }
    },
    {
      "name": "Markup changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#d0b98f"
      }
    },
    {
      "name": "Diff header",
      "scope": ["meta.diff.header", "meta.diff.range"],
      "settings": {
        "foreground": "#b9c4d4"
      }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#c9b6cf"
      }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": {
        "foreground": "#c6a8a5"
      }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css"],
      "settings": {
        "foreground": "#c9c9c9"
      }
    }
  ],
